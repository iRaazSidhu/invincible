---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
---
<BaseLayout title="Page Not Found — Invincible" description="The page you are looking for could not be found." robots="noindex,follow">
  <SiteHeader />
  <main class="container not-found">
    <p class="eyebrow">ERROR / 404</p>
    <h1>That page<br /><span class="accent">isn't here.</span></h1>
    <p>The link may be outdated or the page may have moved. Start again from the homepage or explore the selected work.</p>
    <div class="actions"><a class="button button-primary" href="/">Go to homepage <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/work/">Explore work</a></div>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
.accent{color:var(--color-link)}.not-found{min-height:62vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:70px;padding-bottom:90px}.eyebrow{margin:0 0 22px;color:var(--color-muted);font:11px var(--font-mono)}h1{margin:0;font-size:clamp(58px,11vw,120px);line-height:.96;letter-spacing:-.09em}.not-found>p:not(.eyebrow){max-width:560px;margin:24px 0 28px;color:var(--color-muted);font-size:16px;line-height:1.85}.actions{display:flex;flex-wrap:wrap;gap:12px}
</style>
