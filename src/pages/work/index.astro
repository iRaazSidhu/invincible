---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import { projects } from "../../data/projects";
---
<BaseLayout
  title="Selected Work — Invincible"
  description="Explore selected UI/UX, web design and digital product work, including KaizenX, Cinebit and Zugic."
>
  <SiteHeader />
  <main>
    <section class="page-hero container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Work</span></nav>
      <p class="eyebrow">Selected projects / 2025—2026</p>
      <h1>Work shaped by<br /><span class="accent">clear intent.</span></h1>
      <p class="page-lead">A selection of digital product, web and interface explorations. Each case study outlines the context, design challenge and decisions behind the experience.</p>
    </section>
    <section class="container work-list" aria-labelledby="work-heading">
      <div class="section-top"><h2 id="work-heading">Selected work<span class="accent">.</span></h2><span class="mono-note">{String(projects.length).padStart(2, "0")} PROJECTS</span></div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.title} case study`}>
            <article class="project-card">
              <div class="project-art" aria-hidden="true">
                <span class="art-number">{project.number}</span>
                <span class="art-label">{project.category}</span>
                <div class="art-orbit art-orbit-one"></div><div class="art-orbit art-orbit-two"></div>
                <span class="art-core">{project.title.slice(0, 1)}</span>
              </div>
              <div class="project-meta"><span>{project.category}</span><span>{project.year}</span></div>
              <h2>{project.title}<span aria-hidden="true"> ↗</span></h2>
              <p>{project.summary}</p>
              <span class="read-link">Read case study <span aria-hidden="true">→</span></span>
            </article>
          </a>
        ))}
      </div>
    </section>
    <section class="work-cta">
      <div class="container cta-inner"><p class="eyebrow">Have a project in mind?</p><h2>Let's build something<br /><span class="accent">considered.</span></h2><a class="button button-primary" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
.accent{color:var(--color-link)}.page-hero{padding-top:44px;padding-bottom:76px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin:0 0 64px;color:var(--color-subtle);font:11px var(--font-mono)}.breadcrumbs a:hover{color:var(--color-link)}.eyebrow{margin:0 0 22px}.page-hero h1{margin:0;font-size:clamp(56px,10vw,116px);line-height:.98;letter-spacing:-.085em;font-weight:600}.page-lead{max-width:650px;margin:28px 0 0;color:var(--color-muted);font-size:clamp(16px,2vw,20px);line-height:1.8}.work-list{padding-bottom:clamp(84px,12vw,140px)}.section-top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px;padding-bottom:18px;border-bottom:1px solid var(--color-line)}.section-top h2{margin:0;font-size:clamp(26px,4vw,38px);letter-spacing:-.065em}.mono-note{color:var(--color-subtle);font:10px var(--font-mono)}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 22px}.project-link{display:block;min-width:0}.project-card{height:100%;padding:0 0 20px;border:1px solid var(--color-line);border-radius:var(--radius-md);background:#fff;overflow:hidden;transition:transform 180ms ease,border-color 180ms ease,box-shadow 180ms ease}.project-link:hover .project-card{transform:translateY(-3px);border-color:#d2d2d2;box-shadow:var(--shadow-card-hover)}.project-art{height:clamp(250px,34vw,390px);position:relative;display:grid;place-items:center;overflow:hidden;background:radial-gradient(ellipse at 30% 25%,rgb(0 124 240 / 11%),transparent 50%),linear-gradient(145deg,#f5f5f5,#fff);border-bottom:1px solid var(--color-line)}.project-link:nth-child(2) .project-art{background:radial-gradient(ellipse at 68% 30%,rgb(121 40 202 / 10%),transparent 48%),linear-gradient(145deg,#f5f5f5,#fff)}.project-link:nth-child(3) .project-art{background:radial-gradient(ellipse at 35% 70%,rgb(0 223 216 / 12%),transparent 48%),linear-gradient(145deg,#f5f5f5,#fff)}.art-number,.art-label{position:absolute;top:18px;color:var(--color-subtle);font:10px var(--font-mono)}.art-number{left:18px}.art-label{right:18px}.art-orbit{position:absolute;width:60%;aspect-ratio:1;border:1px solid #d6d6d6;border-radius:50%;transform:rotate(-32deg) scaleY(.55)}.art-orbit-two{width:76%;transform:rotate(45deg) scaleY(.5)}.art-core{width:100px;height:100px;display:grid;place-items:center;border-radius:24px;background:var(--color-ink);color:#fff;font-size:52px;font-weight:600;letter-spacing:-.08em;box-shadow:0 14px 36px rgb(0 0 0 / 12%)}.project-meta{display:flex;justify-content:space-between;gap:14px;padding:22px 22px 0;color:var(--color-muted);font-size:11px}.project-meta span:last-child{font-family:var(--font-mono);color:var(--color-subtle)}.project-card h2{margin:12px 22px 8px;font-size:clamp(24px,3vw,32px);letter-spacing:-.065em}.project-card h2 span{color:var(--color-link);font-size:.7em}.project-card p{margin:0 22px;color:var(--color-muted);font-size:14px;line-height:1.8}.read-link{display:inline-flex;gap:10px;margin:22px 22px 0;color:var(--color-link);font-size:13px;font-weight:500}.work-cta{padding:clamp(74px,10vw,118px) 0;background:var(--color-surface-raised);border-block:1px solid var(--color-line)}.cta-inner h2{margin:0 0 32px;font-size:clamp(42px,7vw,78px);line-height:1.02;letter-spacing:-.075em}.cta-inner .eyebrow{margin-bottom:22px}@media(max-width:650px){.page-hero{padding-top:28px;padding-bottom:54px}.breadcrumbs{margin-bottom:46px}.project-grid{grid-template-columns:1fr}.project-art{height:270px}.section-top{align-items:start;flex-direction:column}}
</style>
