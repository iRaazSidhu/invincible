---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import ProjectCard from "@components/ProjectCard.astro";
const projects = [
 { number:"01", title:"KaizenX", category:"Brand & web experience", summary:"A clear digital presence for a connected ecosystem of crypto products.", year:"2026", filter:"web" as const, visual:"kaizenx" as const, tags:["Digital ecosystem","Web design"] },
 { number:"02", title:"Cinebit", category:"Digital product & UI/UX", summary:"Product interface exploration focused on content discovery and a considered viewing experience.", year:"2026", filter:"product" as const, visual:"cinebit" as const, tags:["Product design","Interface"] },
 { number:"03", title:"Zugic", category:"Corporate digital experience", summary:"A structured corporate presence designed to bring a multi-industry business into focus.", year:"2025", filter:"web" as const, visual:"zugic" as const, tags:["Corporate","Digital experience"] }
];
const services = [
 { number:"01", title:"UI/UX design", description:"Clear information architecture, thoughtful user flows and interfaces that feel easy to understand." },
 { number:"02", title:"Web design", description:"Distinctive portfolio sites and marketing pages with purposeful typography, hierarchy and rhythm." },
 { number:"03", title:"Creative development", description:"Responsive front-end builds that translate design intent into fast, reliable web experiences." },
 { number:"04", title:"Interaction & motion", description:"Useful hover states, transitions and micro-interactions that add clarity without getting in the way." }
];
const processSteps = [
 { number:"01", title:"Understand", description:"Align on the goal, audience, context and what a successful outcome should feel like." },
 { number:"02", title:"Structure", description:"Organise the content, define the journey and establish the right visual direction." },
 { number:"03", title:"Design & build", description:"Develop the interface with responsive layouts, reusable patterns and considered details." },
 { number:"04", title:"Refine", description:"Check the experience across screens, test interactions and polish the details before release." }
];
const tools = ["Figma","Webflow","Framer","Astro","HTML & CSS","JavaScript","GSAP"];
const faqs = [
 { question:"What kind of projects does Invincible focus on?", answer:"The focus is on portfolio websites, marketing pages, digital product interfaces and design-led web experiences. The scope can be shaped around the problem and the team." },
 { question:"How does a project usually begin?", answer:"Start with the goal, intended audience, content, constraints and any useful references. From there, the scope and the most practical next step can be defined." },
 { question:"Which tools and technologies are used?", answer:"The working toolkit includes Figma, Webflow, Framer, Astro and front-end technologies such as HTML, CSS and JavaScript. The right choice depends on the needs of the project." },
 { question:"Will the website work on mobile?", answer:"Responsive behaviour is part of the build: layouts, navigation, spacing, typography and interactions are planned for smaller screens as well as desktop." },
 { question:"Where can I get in touch?", answer:"The GitHub profile is the current public contact point. Use the link below to start a conversation or view the projects and code." }
];
---
<BaseLayout title="Invincible — Digital Design & Development" description="Invincible is an independent design and development portfolio creating thoughtful web experiences, interfaces and purposeful digital details.">
<div id="top"></div>
<SiteHeader />
<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-mesh" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="hero-badge"><span class="status-dot"></span> INDEPENDENT DESIGN & DEVELOPMENT</span>
      <h1 id="hero-title">Digital experiences.<br /><span>Designed with intent.</span></h1>
      <p class="hero-description">I bring design thinking and front-end craft together to make the complex feel clear, and the ordinary feel considered.</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a><a class="button button-secondary" href="/about/">A little about me <span aria-hidden="true">↗</span></a></div>
      <div class="hero-showcase" aria-hidden="true">
        <div class="showcase-topbar"><div class="showcase-dots"><i></i><i></i><i></i></div><span>INVINCIBLE / DIGITAL WORKSPACE</span><span class="showcase-topbar-right">ASTRO + DESIGN</span></div>
        <div class="showcase-main">
          <div class="showcase-copy"><span class="showcase-label">THOUGHTFULLY MADE FOR THE WEB</span><p>Good ideas deserve<br />good <span>execution.</span></p><div class="showcase-mini-link">Design / Develop / Refine <span>↗</span></div></div>
          <div class="showcase-art"><div class="art-frame art-frame--back"></div><div class="art-frame art-frame--front"><div class="art-frame-head"><span>01</span><span>SELECTED PROJECT</span></div><div class="art-frame-lines"><i></i><i></i><i></i></div><div class="art-frame-base"><span>INVINCIBLE</span><span>2026</span></div></div><div class="art-orbit"></div></div>
        </div>
        <div class="showcase-footer"><span>STRATEGY MEETS CRAFT</span><span>BUILT WITH PURPOSE <b>↗</b></span></div>
      </div>
    </div>
  </section>

  <section class="intro-strip" aria-label="Areas of focus"><div class="container intro-strip-inner"><span class="strip-label">A considered mix of</span><div class="strip-items"><span>Design thinking</span><i></i><span>Interface craft</span><i></i><span>Front-end build</span><i></i><span>Useful details</span></div></div></section>

  <section id="work" class="work-section section-pad" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading"><div><p class="section-kicker">01 / SELECTED WORK</p><h2 class="section-title" id="work-title">A few things, made<br />with intent<span class="blue-period">.</span></h2></div><div class="section-intro"><p>A selection of digital experiences, interfaces and brand-led web work. Each project starts with the same question: how can this be clearer, more useful and more memorable?</p><a class="text-link" href="/about/">More about my approach <span aria-hidden="true">↗</span></a></div></div>
      <div class="project-toolbar"><p>PROJECT INDEX <span>— 03 ITEMS</span></p><div class="project-filters" role="group" aria-label="Filter selected projects"><button type="button" data-project-filter="all" aria-pressed="true">All work</button><button type="button" data-project-filter="web" aria-pressed="false">Web & brand</button><button type="button" data-project-filter="product" aria-pressed="false">Product design</button></div></div>
      <div class="project-grid" id="project-grid">{projects.map((project) => <ProjectCard {...project} />)}</div>
      <p class="project-empty" data-project-empty hidden>No projects match this filter yet.</p>
      <div class="work-bottom"><p>Work snapshots are illustrative previews; project details can be expanded into full case studies as assets and outcomes are confirmed.</p><a class="text-link" href="#contact">Discuss a similar project <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section id="services" class="services-section section-pad" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading"><div><p class="section-kicker">02 / WHAT I DO</p><h2 class="section-title" id="services-title">Good design.<br />Thoughtful execution.</h2></div><p class="section-summary">From the first sketch to the final detail, the focus stays on clarity, consistency and a useful end result.</p></div>
      <div class="services-grid">
      {services.map((service) => <article class="service-card">
        <span class="service-number">{service.number}</span>
        <div class="service-icon" aria-hidden="true">
          {service.number === "01" && <svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="4" width="17" height="16" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 9H20.5M8 9V20" stroke="currentColor" stroke-width="1.4"/><path d="M11 13H17M11 16H16" stroke="currentColor" stroke-width="1.4"/></svg>}
          {service.number === "02" && <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3.5" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 8H21M8 8V20.5M12 12H17M12 15.5H17" stroke="currentColor" stroke-width="1.4"/></svg>}
          {service.number === "03" && <svg viewBox="0 0 24 24" fill="none"><path d="M8.5 7L3.5 12L8.5 17M15.5 7L20.5 12L15.5 17M13.5 4L10.5 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
          {service.number === "04" && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}
        </div>
        <h3>{service.title}</h3><p>{service.description}</p><span class="service-arrow" aria-hidden="true">↗</span>
      </article>)}
      </div>
    </div>
  </section>

  <section id="process" class="process-section section-pad" aria-labelledby="process-title">
    <div class="container process-layout">
      <div class="process-heading"><p class="section-kicker">03 / HOW I WORK</p><h2 class="section-title" id="process-title">From first thought<br />to final <span>detail.</span></h2><p class="section-description">A straightforward process with enough structure to keep the work moving—and enough room to make the right decisions as we go.</p><a class="button button-secondary" href="/about/">Explore my approach <span aria-hidden="true">↗</span></a></div>
      <div class="process-list">{processSteps.map((step) => <article class="process-step"><span class="process-number">{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div><span class="process-arrow" aria-hidden="true">↗</span></article>)}</div>
    </div>
  </section>

  <section id="about" class="about-section section-pad" aria-labelledby="about-title">
    <div class="container about-layout">
      <div class="about-statement"><p class="section-kicker">04 / THE THINKING BEHIND THE WORK</p><h2 id="about-title">Curiosity first.<br /><span>Craft in every detail.</span></h2><div class="about-stamp" aria-hidden="true"><span>DESIGN</span><i>×</i><span>DEVELOP</span><i>×</i><span>DETAIL</span></div></div>
      <div class="about-copy"><p class="about-lead">I care about how a digital experience looks, how it works, and how naturally it guides someone through an idea.</p><p>My approach brings interface thinking and front-end craft together—from arranging content and finding the right visual rhythm to building responsive layouts and refining the small interactions.</p><div class="about-values"><div><span>01</span><p>Clarity before decoration</p></div><div><span>02</span><p>Systems over one-off fixes</p></div><div><span>03</span><p>Details with a purpose</p></div></div><a class="text-link" href="/about/">Read the full about page <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="toolkit-section section-pad" aria-labelledby="toolkit-title">
    <div class="container toolkit-layout"><div><p class="section-kicker">05 / TOOLS & TECHNOLOGY</p><h2 class="section-title" id="toolkit-title">The right tools<br />for the right job<span class="blue-period">.</span></h2></div><div class="toolkit-content"><p>Tools support the idea; they don’t replace it. The workflow can move between design, no-code platforms and front-end development depending on the brief.</p><div class="tool-list" aria-label="Tools and technologies">{tools.map((tool, index) => <span class="tool-chip"><i>{String(index + 1).padStart(2, "0")}</i>{tool}</span>)}</div><p class="toolkit-note">The stack stays flexible so the final experience can stay focused.</p></div></div>
  </section>

  <section id="faq" class="faq-section section-pad" aria-labelledby="faq-title">
    <div class="container faq-layout"><div class="faq-intro"><p class="section-kicker">06 / A FEW QUICK ANSWERS</p><h2 class="section-title" id="faq-title">Before we<br />get started<span class="blue-period">.</span></h2><p class="section-description">A few practical details to make the next step clearer.</p></div><div class="faq-list">{faqs.map((faq, index) => <details class="faq-item" open={index === 0}><summary><span>{faq.question}</span><i aria-hidden="true"></i></summary><p>{faq.answer}</p></details>)}</div></div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="container contact-inner"><p class="contact-kicker"><span></span> HAVE A GOOD PROBLEM TO SOLVE?</p><h2 id="contact-title">Let's make<br />something <span>matter.</span></h2><div class="contact-bottom"><p>Have a project, an idea or a challenge worth untangling? Start with a conversation.</p><a class="button button-light" href="https://github.com/iRaazSidhu" target="_blank" rel="noreferrer">Connect on GitHub <span aria-hidden="true">↗</span></a></div></div></section>
</main>
<SiteFooter />
</BaseLayout>

<script>
const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
const projectCards = document.querySelectorAll<HTMLElement>("[data-project-card]");
const emptyMessage = document.querySelector<HTMLElement>("[data-project-empty]");
filterButtons.forEach((button) => button.addEventListener("click", () => {
  const filter = button.dataset.projectFilter ?? "all";
  let visibleCount = 0;
  filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
  projectCards.forEach((card) => {
    const visible = filter === "all" || card.dataset.category === filter;
    card.hidden = !visible;
    if (visible) visibleCount += 1;
  });
  if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
}));
</script>

<style>
.section-pad{padding-block:clamp(76px,9vw,128px)}.blue-period{color:var(--color-link)}
.hero{min-height:650px;position:relative;overflow:hidden;padding:clamp(72px,8.5vw,116px) 0 82px;background:#fff;isolation:isolate}
.hero-mesh{position:absolute;z-index:-1;inset:-15% -12% 12%;pointer-events:none;background:radial-gradient(ellipse at 30% 28%,rgb(0 124 240 / 25%) 0%,transparent 38%),radial-gradient(ellipse at 64% 21%,rgb(0 223 216 / 23%) 0%,transparent 36%),radial-gradient(ellipse at 55% 32%,rgb(121 40 202 / 17%) 0%,transparent 38%),radial-gradient(ellipse at 73% 35%,rgb(255 0 128 / 13%) 0%,transparent 33%),radial-gradient(ellipse at 48% 42%,rgb(249 203 40 / 13%) 0%,transparent 36%);filter:blur(26px);opacity:.9;mask-image:linear-gradient(to bottom,#000 0%,#000 54%,transparent 100%)}
.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero-badge{display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border:1px solid rgb(23 23 23 / 8%);border-radius:var(--radius-pill);background:rgb(255 255 255 / 82%);color:var(--color-muted);font:400 10px/1.4 var(--font-mono);box-shadow:0 1px 1px rgb(0 0 0 / 2%)}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--color-link)}
.hero h1{max-width:1000px;margin:30px 0 0;font-size:clamp(48px,7.7vw,92px);line-height:.99;letter-spacing:-.085em;font-weight:600}.hero h1 span{display:inline-block}
.hero-description{max-width:590px;margin:24px 0 0;color:var(--color-muted);font-size:clamp(16px,1.55vw,18px);line-height:1.75}
.hero-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:30px}
.hero-showcase{width:min(100%,880px);position:relative;margin-top:clamp(58px,7vw,82px);overflow:hidden;border:1px solid rgb(23 23 23 / 10%);border-radius:var(--radius-lg);background:rgb(255 255 255 / 91%);text-align:left;box-shadow:0 1px 1px rgb(0 0 0 / 2%),0 12px 30px -20px rgb(23 23 23 / 22%),inset 0 0 0 1px rgb(255 255 255 / 65%);backdrop-filter:blur(14px)}
.showcase-topbar{height:42px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;padding:0 18px;border-bottom:1px solid var(--color-line);color:var(--color-subtle);font:400 9px/1 var(--font-mono)}
.showcase-dots{display:flex;gap:5px}.showcase-dots i{width:7px;height:7px;border:1px solid #bcbcbc;border-radius:50%}.showcase-topbar-right{text-align:right}
.showcase-main{min-height:235px;display:grid;grid-template-columns:1fr .86fr;align-items:center;gap:24px;padding:clamp(24px,4vw,42px)}
.showcase-label{color:var(--color-subtle);font:400 9px/1.4 var(--font-mono)}
.showcase-copy>p{margin:14px 0 16px;font-size:clamp(25px,3.4vw,42px);line-height:1.05;letter-spacing:-.07em;font-weight:500}.showcase-copy>p span{color:var(--color-link)}
.showcase-mini-link{display:inline-flex;align-items:center;gap:14px;padding-bottom:6px;border-bottom:1px solid var(--color-line-strong);color:var(--color-muted);font:400 10px/1.5 var(--font-mono)}.showcase-mini-link span{color:var(--color-link)}
.showcase-art{min-height:170px;position:relative;display:grid;place-items:center;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:var(--color-surface-soft)}
.art-frame{position:absolute;width:61%;aspect-ratio:1.05/1;border:1px solid #dedede;border-radius:var(--radius-sm);background:#fff}.art-frame--back{transform:translate(-23%,-4%) rotate(-10deg);background:#f5f5f5}.art-frame--front{transform:translate(8%,7%) rotate(7deg);padding:12px;box-shadow:var(--shadow-card)}
.art-frame-head,.art-frame-base{display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--color-subtle);font:400 7px/1.3 var(--font-mono)}
.art-frame-lines{display:grid;gap:7px;margin-top:24px}.art-frame-lines i{height:5px;border-radius:100px;background:#e5e5e5}.art-frame-lines i:first-child{width:84%;background:#171717}.art-frame-lines i:nth-child(2){width:65%}.art-frame-lines i:nth-child(3){width:74%}
.art-frame-base{position:absolute;right:12px;bottom:12px;left:12px}.art-orbit{position:absolute;width:100px;height:100px;border:1px solid rgb(0 112 243 / 24%);border-radius:50%;transform:translate(60%,-50%)}
.showcase-footer{display:flex;justify-content:space-between;gap:16px;padding:13px 18px;border-top:1px solid var(--color-line);color:var(--color-subtle);font:400 8px/1.4 var(--font-mono)}.showcase-footer b{color:var(--color-link);font-weight:400}
.intro-strip{border-block:1px solid var(--color-line);background:#fff}.intro-strip-inner{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}.strip-label{color:var(--color-subtle);font-size:12px}
.strip-items{display:flex;align-items:center;flex-wrap:wrap;gap:15px;color:var(--color-muted);font-size:12px}.strip-items i{width:4px;height:4px;border-radius:50%;background:var(--color-link)}
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:clamp(28px,6vw,84px);margin-bottom:46px}.section-heading>div:first-child{flex:1 1 auto}.section-intro{width:min(100%,400px);flex:0 1 400px}.section-intro>p{margin:0 0 18px;color:var(--color-muted);font-size:14px;line-height:1.8}.section-summary{max-width:380px;margin:0 0 4px;color:var(--color-muted);font-size:14px;line-height:1.8}
.project-toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 0;border-block:1px solid var(--color-line)}.project-toolbar>p{margin:0;color:var(--color-ink);font:400 10px/1.5 var(--font-mono)}.project-toolbar>p span{color:var(--color-subtle)}
.project-filters{display:flex;flex-wrap:wrap;gap:4px}.project-filters button{min-height:34px;padding:0 12px;border:1px solid transparent;border-radius:var(--radius-pill);background:transparent;color:var(--color-muted);font-size:12px;cursor:pointer;transition:color 160ms ease,background-color 160ms ease,border-color 160ms ease}
.project-filters button:hover{color:var(--color-ink);background:var(--color-surface-raised)}.project-filters button[aria-pressed="true"]{border-color:var(--color-line);background:#fff;color:var(--color-ink);box-shadow:var(--shadow-card)}
.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:24px}.project-empty{margin:30px 0 0;color:var(--color-muted);font-size:14px}
.work-bottom{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-top:26px}.work-bottom>p{max-width:580px;margin:0;color:var(--color-subtle);font-size:11px;line-height:1.7}
.services-section{background:#fff;border-block:1px solid var(--color-line)}.services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.service-card{min-height:270px;position:relative;display:flex;flex-direction:column;align-items:start;padding:22px;border:1px solid var(--color-line);border-radius:var(--radius-md);background:var(--color-canvas);box-shadow:var(--shadow-card);transition:border-color 180ms ease,transform 180ms ease,box-shadow 180ms ease}
.service-card:hover{transform:translateY(-3px);border-color:#d8d8d8;box-shadow:var(--shadow-card-hover)}.service-number{color:var(--color-subtle);font:400 10px/1.4 var(--font-mono)}
.service-icon{width:38px;height:38px;display:grid;place-items:center;margin-top:32px;border:1px solid var(--color-line);border-radius:var(--radius-sm);color:var(--color-ink)}.service-icon svg{width:20px;height:20px}
.service-card h3{margin:22px 0 8px;font-size:17px;line-height:1.3;font-weight:500;letter-spacing:-.04em}.service-card>p{margin:0;color:var(--color-muted);font-size:12px;line-height:1.75}.service-arrow{position:absolute;top:22px;right:22px;color:var(--color-link);font-size:17px}
.process-section{background:var(--color-ink);color:#fff}.process-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(38px,8vw,112px)}
.process-section .section-kicker{color:#a1a1a1}.process-heading .section-title{color:#fff}.process-heading .section-title span{color:#b8b8b8}.process-section .section-description{max-width:420px;margin-bottom:28px;color:#b5b5b5}
.process-section .button-secondary{border-color:#454545;background:transparent;color:#fff}.process-section .button-secondary:hover{background:#252525;border-color:#686868}.process-list{border-top:1px solid #3a3a3a}
.process-step{display:grid;grid-template-columns:36px minmax(0,1fr) 24px;align-items:start;gap:14px;padding:24px 0;border-bottom:1px solid #3a3a3a}.process-number{padding-top:4px;color:#a1a1a1;font:400 10px/1.4 var(--font-mono)}
.process-step h3{margin:0 0 8px;font-size:18px;font-weight:500;letter-spacing:-.035em}.process-step p{margin:0;color:#b5b5b5;font-size:13px;line-height:1.8}.process-arrow{color:#fff;font-size:16px;text-align:right}
.about-section{background:var(--color-surface-soft)}.about-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.82fr);gap:clamp(38px,8vw,110px)}
.about-statement h2{margin:0;font-size:clamp(42px,6vw,72px);line-height:1.02;letter-spacing:-.075em;font-weight:600}.about-statement h2 span{color:#888}
.about-stamp{display:flex;align-items:center;gap:10px;margin-top:38px;color:var(--color-subtle);font:400 9px/1.4 var(--font-mono)}.about-stamp i{color:var(--color-link);font-style:normal}
.about-copy{align-self:center}.about-copy>p{margin:0 0 18px;color:var(--color-muted);font-size:14px;line-height:1.9}.about-copy>.about-lead{margin-bottom:20px;color:var(--color-ink);font-size:20px;line-height:1.55;letter-spacing:-.035em}
.about-values{margin:28px 0;border-top:1px solid var(--color-line)}.about-values>div{display:flex;align-items:center;gap:16px;padding:13px 0;border-bottom:1px solid var(--color-line)}.about-values span{color:var(--color-subtle);font:400 10px/1.4 var(--font-mono)}.about-values p{margin:0;font-size:13px}
.toolkit-section{background:#fff}.toolkit-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:clamp(36px,8vw,100px)}
