---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import ProjectCard from "@components/ProjectCard.astro";

const projects = [
  { number: "01", title: "KaizenX", category: "Brand experience / Web design", year: "2026", tone: "lime" as const },
  { number: "02", title: "Cinebit", category: "Digital product / UI design", year: "2026", tone: "violet" as const },
  { number: "03", title: "Zugic", category: "Strategy / Digital experience", year: "2025", tone: "orange" as const }
];

const services = ["Digital experiences", "Interface design", "Creative development", "Motion & interaction"];
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-meta">
        <span class="eyebrow">Independent creative practice</span>
        <span class="meta-location">Based in India · Working worldwide</span>
      </div>
      <h1 id="hero-title">Making digital<br />feel <span class="highlight">different.</span></h1>
      <div class="hero-bottom">
        <p class="hero-copy">I design and build thoughtful digital experiences for ambitious ideas, brands, and products.</p>
        <a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-stamp" aria-hidden="true">
        <span>DESIGN</span><span>×</span><span>DEVELOP</span><span>×</span><span>DETAIL</span>
      </div>
    </section>

    <section id="work" class="work-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">A few things made with intent</span>
            <h2>Selected work<span class="highlight">.</span></h2>
          </div>
          <p>2025 — 2026<br />Independent & collaborative</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
        <p class="work-note">A starting collection — more case studies coming into focus.</p>
      </div>
    </section>

    <section id="about" class="about-section container">
      <div class="about-label"><span class="eyebrow">A little about me</span></div>
      <div class="about-content">
        <h2>Curiosity first.<br /><span class="muted">Craft in every detail.</span></h2>
        <p>I bring design thinking and front-end craft together to turn complex ideas into clear, engaging experiences. The goal is always the same: make useful things feel unmistakably human.</p>
        <div class="service-list">
          {services.map((service, index) => <div class="service-item"><span>0{index + 1}</span><span>{service}</span><span aria-hidden="true">↗</span></div>)}
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="container contact-inner">
        <span class="eyebrow">Have something good in mind?</span>
        <h2>Let's make it<br /><span class="highlight">matter.</span></h2>
        <a class="contact-link" href="mailto:hello@invincible.design">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <footer class="site-footer container">
    <a class="footer-mark" href="/">INVINCIBLE<span class="highlight">.</span></a>
    <span>Designed with intent · Built for the web</span>
    <a href="#hero-title">Back to top ↑</a>
  </footer>
</BaseLayout>

<style>
  .hero { position: relative; padding-top: clamp(64px, 10vw, 130px); padding-bottom: clamp(80px, 12vw, 155px); }
  .hero-meta { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .meta-location { color: var(--color-muted); font: 11px var(--font-mono); }
  h1, h2, p { overflow-wrap: break-word; }
  .hero h1 {
    max-width: 1050px;
    margin: clamp(38px, 6vw, 74px) 0 34px;
    font-size: clamp(64px, 11.5vw, 150px);
    line-height: .91;
    font-weight: 600;
    letter-spacing: -.095em;
  }
  .highlight { color: var(--color-accent); }
  .hero-bottom { display: flex; align-items: end; justify-content: space-between; gap: 28px; max-width: 810px; }
  .hero-copy { max-width: 390px; margin: 0; color: var(--color-muted); font-size: clamp(15px, 1.8vw, 19px); line-height: 1.8; }
  .text-link { display: inline-flex; align-items: center; gap: 24px; padding-bottom: 8px; border-bottom: 1px solid var(--color-accent); font-size: 12px; white-space: nowrap; }
  .text-link span { color: var(--color-accent); font-size: 17px; }
  .hero-stamp { position: absolute; right: 25px; bottom: 35px; display: flex; gap: 9px; color: #77796f; font: 9px var(--font-mono); letter-spacing: .08em; }
  .hero-stamp span:nth-child(even) { color: var(--color-accent); }
  .work-section { padding: clamp(70px, 10vw, 120px) 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); background: #141512; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 42px; }
  .section-heading h2, .about-content h2, .contact-inner h2 { margin: 18px 0 0; font-size: clamp(42px, 6vw, 74px); line-height: 1; font-weight: 600; letter-spacing: -.075em; }
  .section-heading > p { margin: 0 0 6px; color: var(--color-muted); font: 10px/1.8 var(--font-mono); text-align: right; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .work-note { margin: 34px 0 0; color: var(--color-muted); font-size: 12px; }
  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 70px; padding-top: clamp(80px, 12vw, 155px); padding-bottom: clamp(80px, 12vw, 155px); }
  .about-content h2 { margin: 0; }
  .muted { color: #77796f; }
  .about-content > p { max-width: 540px; margin: 28px 0 45px; color: var(--color-muted); font-size: 16px; line-height: 1.9; }
  .service-list { border-top: 1px solid var(--color-line); }
  .service-item { display: grid; grid-template-columns: 48px 1fr 20px; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--color-line); font-size: 13px; }
  .service-item span:first-child { color: var(--color-muted); font: 10px var(--font-mono); }
  .service-item span:last-child { color: var(--color-accent); text-align: right; }
  .contact-section { padding: clamp(80px, 12vw, 145px) 0; background: var(--color-accent); color: var(--color-bg); }
  .contact-section .eyebrow { color: rgb(16 17 15 / 65%); }
  .contact-section .eyebrow::before { background: var(--color-bg); }
  .contact-inner h2 { margin-bottom: 42px; font-size: clamp(64px, 11vw, 130px); }
  .contact-inner .highlight { color: rgb(16 17 15 / 42%); }
  .contact-link { display: inline-flex; align-items: center; gap: 36px; padding-bottom: 12px; border-bottom: 1px solid rgb(16 17 15 / 35%); font-size: 14px; font-weight: 700; }
  .contact-link span { font-size: 20px; }
  .site-footer { min-height: 92px; display: flex; align-items: center; justify-content: space-between; gap: 24px; color: var(--color-muted); font: 10px var(--font-mono); }
  .footer-mark { color: var(--color-text); font: 800 11px var(--font-sans); letter-spacing: .14em; }
  .site-footer a:last-child { white-space: nowrap; }
  @media (max-width: 850px) {
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-grid :global(.project-card:last-child) { display: none; }
    .about-section { grid-template-columns: 1fr; gap: 30px; }
  }
  @media (max-width: 640px) {
    .hero-meta { align-items: start; flex-direction: column; }
    .hero h1 { font-size: clamp(56px, 15vw, 92px); }
    .hero-bottom { align-items: start; flex-direction: column; }
    .hero-stamp { right: 16px; bottom: 26px; font-size: 8px; }
    .section-heading { align-items: start; flex-direction: column; }
    .section-heading > p { text-align: left; }
    .project-grid { grid-template-columns: 1fr; gap: 34px; }
    .project-grid :global(.project-card:last-child) { display: block; }
    .project-art { aspect-ratio: 1.15 / 1; }
    .about-content h2 { font-size: clamp(40px, 10vw, 60px); }
    .site-footer { flex-wrap: wrap; padding-block: 24px; }
    .site-footer > span { order: 3; width: 100%; }
  }
</style>
