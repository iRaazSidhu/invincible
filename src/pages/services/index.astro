---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
const services = [
  { number: "01", title: "UI/UX design", description: "Information architecture, user flows, wireframes and interface design shaped around a clear user need.", includes: ["User journeys and flows", "Wireframes and interface layouts", "Reusable design patterns", "Responsive state planning"] },
  { number: "02", title: "Web design", description: "Portfolio and marketing website experiences with considered typography, content hierarchy and a coherent visual system.", includes: ["Page structure and hierarchy", "Responsive visual direction", "Component and section design", "Content-aware page layouts"] },
  { number: "03", title: "Creative development", description: "Responsive front-end implementation that translates the design intent into a reliable, maintainable website.", includes: ["Semantic HTML and CSS", "Responsive implementation", "Reusable UI components", "Build and cross-screen checks"] },
  { number: "04", title: "Interaction & motion", description: "Purposeful hover states, transitions and micro-interactions that make interface feedback easier to understand.", includes: ["Interaction concepts", "Hover and focus states", "Motion refinement", "Reduced-motion considerations"] }
];
---
<BaseLayout title="Services — UI/UX, Web Design & Creative Development | Invincible" description="Explore Invincible's services: UI/UX design, portfolio and marketing websites, creative front-end development, and purposeful interaction design.">
  <SiteHeader />
  <main>
    <section class="container services-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Services</span></nav>
      <p class="eyebrow">Ways we can work together</p>
      <h1>Good work starts<br />with <span class="accent">clear thinking.</span></h1>
      <p class="lead">From early structure to polished interface, the goal is the same: make digital experiences easier to understand, easier to use and easier to maintain.</p>
      <a class="button button-primary" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a>
    </section>
    <section class="container services-list" aria-label="Services">
      {services.map((service) => (
        <article class="service-row">
          <span class="service-number">{service.number}</span>
          <div class="service-main"><h2>{service.title}<span class="accent">.</span></h2><p>{service.description}</p></div>
          <div class="service-includes"><h3>Possible scope</h3><ul>{service.includes.map((item) => <li>{item}</li>)}</ul></div>
        </article>
      ))}
    </section>
    <section class="fit-section"><div class="container fit-grid"><div><p class="eyebrow">A thoughtful starting point</p><h2>Start with the<br /><span class="accent">problem, not a tool.</span></h2></div><div><p>Every project has different constraints. Before recommending a tool or jumping into the interface, align on the audience, the business goal, the content that needs to exist and how the result will be maintained.</p><p>Scope, deliverables and timing should be agreed together before work begins. The service overview is a starting point, not a fixed package or a promise that every project needs every discipline.</p><a class="text-link" href="/work/">Explore selected work <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
.accent{color:var(--color-link)}.services-hero{padding-top:40px;padding-bottom:clamp(62px,10vw,112px)}.breadcrumbs{display:flex;gap:10px;margin:0 0 62px;color:var(--color-subtle);font:11px var(--font-mono)}.breadcrumbs a:hover{color:var(--color-link)}.eyebrow{margin:0 0 20px;color:var(--color-muted);font:11px var(--font-mono)}h1{margin:0;font-size:clamp(53px,10vw,112px);line-height:.98;letter-spacing:-.085em;font-weight:600}.lead{max-width:690px;margin:28px 0 30px;color:var(--color-muted);font-size:clamp(17px,2.2vw,21px);line-height:1.8}.services-list{padding-bottom:clamp(70px,10vw,120px)}.service-row{display:grid;grid-template-columns:55px minmax(0,1fr) minmax(220px,.75fr);gap:clamp(22px,4vw,55px);padding:32px 0;border-top:1px solid var(--color-line)}.service-number{color:var(--color-link);font:11px var(--font-mono)}.service-main h2{margin:-7px 0 14px;font-size:clamp(27px,4vw,44px);letter-spacing:-.07em}.service-main p{max-width:540px;margin:0;color:var(--color-muted);font-size:14px;line-height:1.9}.service-includes h3{margin:0 0 13px;color:var(--color-subtle);font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.05em}.service-includes ul{display:grid;gap:9px;margin:0;padding:0;list-style:none}.service-includes li{position:relative;padding-left:17px;color:var(--color-muted);font-size:12px;line-height:1.65}.service-includes li:before{position:absolute;left:0;color:var(--color-link);content:"↗"}.fit-section{padding:clamp(65px,9vw,105px) 0;background:var(--color-surface-raised);border-block:1px solid var(--color-line)}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(35px,8vw,100px)}.fit-grid h2{margin:0;font-size:clamp(38px,6vw,66px);line-height:1.02;letter-spacing:-.075em}.fit-grid p:not(.eyebrow){margin:0 0 18px;color:var(--color-muted);font-size:14px;line-height:1.9}.text-link{display:inline-flex;gap:10px;margin-top:10px;color:var(--color-link);font-size:13px}@media(max-width:700px){.services-hero{padding-top:28px}.breadcrumbs{margin-bottom:46px}.service-row{grid-template-columns:35px 1fr;gap:14px 18px}.service-includes{grid-column:2}.fit-grid{grid-template-columns:1fr;gap:28px}}
</style>
