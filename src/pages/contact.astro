---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
---
<BaseLayout title="Contact — Start a Project with Invincible" description="Get in touch about UI/UX design, web design, creative development or an interaction-design project.">
  <SiteHeader />
  <main>
    <section class="container contact-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Contact</span></nav>
      <p class="eyebrow">The next step</p>
      <h1>Have a good<br />problem to <span class="accent">solve?</span></h1>
      <p class="lead">Share a little about what you're building, what feels unclear or what you'd like to improve. The best starting point is a clear conversation about the problem.</p>
      <a class="button button-primary" href="https://github.com/iRaazSidhu" target="_blank" rel="noopener noreferrer">Connect on GitHub <span aria-hidden="true">↗</span></a>
      <p class="external-note">This link opens an external profile. There is no contact form on this site.</p>
    </section>
    <section class="contact-details"><div class="container details-grid"><div><p class="eyebrow">Useful context to share</p><h2>A little detail<br />goes a long way.</h2></div><div class="prompt-list"><article><span>01</span><p>What are you building, and who is it for?</p></article><article><span>02</span><p>Which part needs the most help: structure, design, development or interaction?</p></article><article><span>03</span><p>Is there a timeline, existing website or reference that would help explain the context?</p></article></div></div></section>
    <section class="container contact-bottom"><p class="eyebrow">Before you go</p><h2>See how the thinking<br />shows up in the <span class="accent">work.</span></h2><a class="text-link" href="/work/">Explore selected projects <span aria-hidden="true">↗</span></a></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
.accent{color:var(--color-link)}.contact-hero{padding-top:40px;padding-bottom:clamp(72px,11vw,130px)}.breadcrumbs{display:flex;gap:10px;margin:0 0 64px;color:var(--color-subtle);font:11px var(--font-mono)}.breadcrumbs a:hover{color:var(--color-link)}.eyebrow{margin:0 0 20px;color:var(--color-muted);font:11px var(--font-mono)}h1{margin:0;font-size:clamp(56px,11vw,122px);line-height:.97;letter-spacing:-.09em}.lead{max-width:680px;margin:28px 0 30px;color:var(--color-muted);font-size:clamp(17px,2.3vw,22px);line-height:1.85}.external-note{margin:16px 0 0;color:var(--color-subtle);font-size:11px}.contact-details{padding:clamp(62px,9vw,105px) 0;background:var(--color-surface-raised);border-block:1px solid var(--color-line)}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,8vw,100px)}.details-grid h2,.contact-bottom h2{margin:0;font-size:clamp(36px,6vw,64px);line-height:1.03;letter-spacing:-.075em}.prompt-list{border-top:1px solid var(--color-line)}.prompt-list article{display:grid;grid-template-columns:32px 1fr;gap:18px;padding:20px 0;border-bottom:1px solid var(--color-line)}.prompt-list article span{color:var(--color-link);font:10px var(--font-mono)}.prompt-list article p{margin:0;color:var(--color-muted);font-size:14px;line-height:1.8}.contact-bottom{padding-top:clamp(72px,10vw,118px);padding-bottom:clamp(72px,10vw,118px)}.contact-bottom h2{margin-bottom:28px}.text-link{display:inline-flex;gap:8px;color:var(--color-link);font-size:13px;font-weight:500}@media(max-width:680px){.contact-hero{padding-top:28px}.breadcrumbs{margin-bottom:46px}.details-grid{grid-template-columns:1fr;gap:30px}}
</style>
