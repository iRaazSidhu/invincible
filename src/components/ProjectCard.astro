---
interface Props {
  number: string; title: string; category: string; summary: string; year: string; href: string;
  filter: "web" | "product"; visual: "kaizenx" | "cinebit" | "zugic"; tags: string[];
}
const { number, title, category, summary, year, href, filter, visual, tags } = Astro.props;
---
<a class="project-card" href={href} data-project-card data-category={filter} aria-label={`Read the ${title} case study`}>
  <div class={"project-visual project-visual--" + visual} aria-hidden="true">
    <div class="window-bar"><div class="window-controls"><i></i><i></i><i></i></div><span>INVINCIBLE / WORK SAMPLE {number}</span><span class="window-menu">•••</span></div>
    {visual === "kaizenx" && <div class="visual-content visual-content--ecosystem"><span class="visual-overline">CONNECTED DIGITAL ECOSYSTEM</span><h3>One ecosystem.<br />Many possibilities.</h3><div class="ecosystem-grid"><span>Exchange <b>↗</b></span><span>Wallet <b>↗</b></span><span>Discover <b>↗</b></span></div><div class="visual-foot"><span>01 / DIGITAL EXPERIENCE</span><span>KAIZENX</span></div></div>}
    {visual === "cinebit" && <div class="visual-content visual-content--product"><span class="visual-overline">DISCOVERY / INTERFACE</span><h3>Find your<br />next favourite.</h3><div class="content-preview-grid"><span><i></i><b>Featured</b></span><span><i></i><b>Explore</b></span><span><i></i><b>My list</b></span></div><div class="visual-foot"><span>02 / DIGITAL PRODUCT</span><span>CINEBIT</span></div></div>}
    {visual === "zugic" && <div class="visual-content visual-content--corporate"><span class="visual-overline">CORPORATE / DIGITAL EXPERIENCE</span><h3>Built for<br />what comes next.</h3><div class="corporate-lines"><i></i><i></i><i></i></div><div class="visual-foot"><span>03 / CORPORATE EXPERIENCE</span><span>ZUGIC</span></div></div>}
  </div>
  <div class="project-content">
    <div class="project-meta"><span>{category}</span><span>{year}</span></div>
    <h3>{title}</h3><p class="project-summary">{summary}</p>
    <div class="project-tags">{tags.map((tag) => <span>{tag}</span>)}</div>
  </div>
</a>
<style>
.project-card{display:block;color:inherit;text-decoration:none;min-width:0;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-md);background:var(--color-canvas);box-shadow:var(--shadow-card);transition:box-shadow 180ms ease,transform 180ms ease,border-color 180ms ease}
.project-card:hover{transform:translateY(-3px);border-color:#d8d8d8;box-shadow:var(--shadow-card-hover)}
.project-visual{min-height:288px;position:relative;overflow:hidden;background:var(--color-surface-raised);border-bottom:1px solid var(--color-line)}
.window-bar{height:34px;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--color-line);background:#fff;color:var(--color-subtle);font:400 9px/1 var(--font-mono)}
.window-controls{display:flex;gap:4px}.window-controls i{width:6px;height:6px;border:1px solid #c8c8c8;border-radius:50%}
.window-bar>span:nth-child(2){flex:1;text-align:center}.window-menu{letter-spacing:2px}
.visual-content{min-height:253px;display:flex;flex-direction:column;align-items:start;padding:22px clamp(18px,2.4vw,28px) 14px}
.visual-overline{color:var(--color-muted);font:400 9px/1.4 var(--font-mono);letter-spacing:.02em}
.visual-content h3{margin:15px 0 20px;color:var(--color-ink);font-size:clamp(22px,2.5vw,31px);line-height:1.02;letter-spacing:-.065em;font-weight:500}
.ecosystem-grid{width:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:auto}
.ecosystem-grid span{display:flex;align-items:center;justify-content:space-between;gap:4px;padding:10px 8px;border:1px solid #e0e0e0;border-radius:var(--radius-xs);background:#fff;color:var(--color-muted);font-size:9px}
.ecosystem-grid b{color:var(--color-link);font-size:10px;font-weight:500}
.visual-foot{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:18px;color:var(--color-subtle);font:400 8px/1.2 var(--font-mono)}
.content-preview-grid{width:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:auto}
.content-preview-grid span{overflow:hidden;border:1px solid #e0e0e0;border-radius:var(--radius-xs);background:#fff}
.content-preview-grid i{display:block;height:45px;border-bottom:1px solid var(--color-line);background:linear-gradient(145deg,#e8e8e8,#f9f9f9)}
.content-preview-grid b{display:block;padding:7px 6px;color:var(--color-muted);font-size:8px;font-weight:500}
.corporate-lines{width:100%;display:grid;gap:7px;margin-top:auto}
.corporate-lines i{display:block;height:5px;border-radius:100px;background:#e1e1e1}
.corporate-lines i:nth-child(1){width:94%}.corporate-lines i:nth-child(2){width:71%}.corporate-lines i:nth-child(3){width:83%}
.project-content{padding:20px}.project-meta{display:flex;justify-content:space-between;gap:10px;color:var(--color-muted);font-size:11px}
.project-meta span:last-child{color:var(--color-subtle);font-family:var(--font-mono)}
.project-content>h3{margin:14px 0 8px;font-size:23px;line-height:1.2;font-weight:600;letter-spacing:-.055em}
.project-summary{min-height:50px;margin:0;color:var(--color-muted);font-size:13px;line-height:1.75}
.project-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
.project-tags span{padding:5px 8px;border:1px solid var(--color-line);border-radius:var(--radius-pill);color:var(--color-muted);font-size:10px}
@media(max-width:640px){.project-visual{min-height:260px}.visual-content{min-height:225px}.project-content{padding:18px}}
</style>
